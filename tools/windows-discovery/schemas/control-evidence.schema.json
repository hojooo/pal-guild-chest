{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CGCE Windows discovery control evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "maintenance_id",
    "run_id",
    "operator",
    "server_root",
    "palserver_executable",
    "server_process_paths",
    "server_process_paths_complete",
    "ue4ss_root",
    "ue4ss_version",
    "ue4ss_dll_sha256",
    "listener_ports",
    "production_restart_disabled",
    "external_access_blocked",
    "players_disconnected",
    "bundle_checksum",
    "verified_at_utc",
    "valid_until_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "cgce_windows_discovery_control"
    },
    "maintenance_id": {
      "type": "string",
      "pattern": "^m-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r-[0-9a-f]{32}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "server_root": {
      "type": "string",
      "minLength": 1
    },
    "palserver_executable": {
      "type": "string",
      "minLength": 1
    },
    "server_process_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "server_process_paths_complete": {
      "const": true
    },
    "ue4ss_root": {
      "type": "string",
      "minLength": 1
    },
    "ue4ss_version": {
      "const": "3.0.1"
    },
    "ue4ss_dll_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "listener_ports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "production_restart_disabled": {
      "const": true
    },
    "external_access_blocked": {
      "const": true
    },
    "players_disconnected": {
      "const": true
    },
    "bundle_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "valid_until_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
