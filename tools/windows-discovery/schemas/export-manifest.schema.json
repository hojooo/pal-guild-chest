{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CGCE Windows discovery private export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "privacy",
    "created_at_utc",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "cgce_windows_discovery_export_manifest"
    },
    "run_id": {
      "type": "string",
      "minLength": 34,
      "maxLength": 34,
      "pattern": "^r-[0-9a-f]{32}$"
    },
    "privacy": {
      "const": "PRIVATE"
    },
    "created_at_utc": {
      "$ref": "#/definitions/strictUtc"
    },
    "payload": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "length",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/definitions/checksum"
          }
        }
      }
    }
  },
  "definitions": {
    "checksum": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "strictUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
