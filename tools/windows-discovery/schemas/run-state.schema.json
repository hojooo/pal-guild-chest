            }
          }
        },
        "probe_receipt_checksum": {
          "type": "null"
        },
        "process_launch_receipt_checksum": {
          "type": "null"
        },
        "process_result_receipt_checksum": {
          "type": "null"
        },
        "capture_inventory_checksum": {
          "type": "null"
        }
      }
    },
    "recoverySourceCloneEvidence": {
      "properties": {
        "inventory_checksums": {
          "properties": {
            "backup": {
              "$ref": "#/definitions/checksum"
            },
            "clone": {
              "$ref": "#/definitions/checksum"
            }
          }
        },
        "probe_receipt_checksum": {
          "type": "null"
        },
        "process_launch_receipt_checksum": {
          "type": "null"
        },
        "process_result_receipt_checksum": {
          "type": "null"
        },
        "capture_inventory_checksum": {
          "type": "null"
        }
      }
    },
    "recoverySourceRunningEvidence": {
      "properties": {
        "inventory_checksums": {
          "properties": {
            "backup": {
              "$ref": "#/definitions/checksum"
            },
            "clone": {
              "$ref": "#/definitions/checksum"
            }
          }
        },
        "probe_receipt_checksum": {
          "$ref": "#/definitions/checksum"
        },
        "process_launch_receipt_checksum": {
          "type": "null"
        },
        "process_result_receipt_checksum": {
          "type": "null"
        },
        "capture_inventory_checksum": {
          "type": "null"
        }
      }
    },
    "recoverySourceCapturedEvidence": {
      "properties": {
        "inventory_checksums": {
          "properties": {
            "backup": {
              "$ref": "#/definitions/checksum"
            },
            "clone": {
              "$ref": "#/definitions/checksum"
            }
          }
        },
        "probe_receipt_checksum": {
          "$ref": "#/definitions/checksum"
        },
        "process_launch_receipt_checksum": {
          "$ref": "#/definitions/checksum"
        },
        "process_result_receipt_checksum": {
          "$ref": "#/definitions/checksum"
        },
        "capture_inventory_checksum": {
          "$ref": "#/definitions/checksum"
        }
      }
    }
