{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CGCE Windows discovery run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "revision",
    "run_id",
    "maintenance_id",
    "phase",
    "outcome",
    "created_at_utc",
    "updated_at_utc",
    "bundle_checksum",
    "control_evidence_checksum",
    "source_manifest_checksum",
    "palserver_executable",
    "palserver_executable_checksum",
    "ue4ss_version",
    "server_process_paths",
    "ue4ss_dll_checksum",
    "listener_ports",
    "paths",
    "inventory_checksums",
    "probe_receipt_checksum",
    "process_launch_receipt_checksum",
    "process_result_receipt_checksum",
    "capture_inventory_checksum",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "cgce_windows_discovery_run_state"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": "string",
      "minLength": 34,
      "maxLength": 34,
      "pattern": "^r-[0-9a-f]{32}$"
    },
    "maintenance_id": {
      "type": "string",
      "minLength": 34,
      "maxLength": 34,
      "pattern": "^m-[0-9a-f]{32}$"
    },
    "phase": {
      "enum": [
        "CREATED",
        "BACKUP_VERIFIED",
        "ORIGINAL_DEACTIVATED",
        "CLONE_ACTIVE",
        "PROBE_STAGED",
        "RUNNING",
        "CAPTURED",
        "RESTORING",
        "RESTORED",
        "EXPORTED"
      ]
    },
    "outcome": {
      "enum": [
        "ACTIVE",
        "SUCCEEDED",
        "BLOCKED"
      ]
    },
    "created_at_utc": {
      "$ref": "#/definitions/strictUtc"
    },
    "updated_at_utc": {
      "$ref": "#/definitions/strictUtc"
    },
    "bundle_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "control_evidence_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "source_manifest_checksum": {
      "$ref": "#/definitions/checksum"
    },
    "palserver_executable": {
      "$ref": "#/definitions/nullableNonEmptyString"
    },
    "palserver_executable_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "ue4ss_version": {
      "anyOf": [
        {
          "const": "3.0.1"
        },
        {
          "type": "null"
        }
      ]
    },
    "server_process_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ue4ss_dll_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "listener_ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_root",
        "run_root",
        "run_directory",
        "state",
        "genesis_state",
        "control_evidence",
        "active_run_marker",
        "completed_run_marker",
        "active_saved",
        "inactive_original",
        "quarantined_clone",
        "backup_saved",
        "original_inventory",
        "backup_inventory",
        "clone_inventory",
        "restored_inventory",
        "ue4ss_root",
        "ue4ss_dll",
        "mods_txt",
        "mods_original",
        "mods_test",
        "probe_staged",
        "probe_quarantine",
        "object_dump",
        "object_dump_original",
        "object_dump_quarantine",
        "cxx_header_dump",
        "cxx_header_dump_original",
        "cxx_header_dump_quarantine",
        "ue4ss_log",
        "ue4ss_log_original",
        "ue4ss_log_quarantine",
        "capture",
        "probe_intent",
        "probe_receipt",
        "probe_receipts",
        "process_launch_receipt",
        "process_result_receipt",
        "process_receipts",
        "capture_inventory",
        "restore_receipts"
      ],
      "properties": {
        "server_root": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "run_root": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "run_directory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "state": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "genesis_state": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "control_evidence": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "active_run_marker": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "completed_run_marker": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "active_saved": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "inactive_original": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "quarantined_clone": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "backup_saved": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "original_inventory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "backup_inventory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "clone_inventory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "restored_inventory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ue4ss_root": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ue4ss_dll": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mods_txt": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mods_original": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mods_test": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "probe_staged": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "probe_quarantine": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "object_dump": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "object_dump_original": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "object_dump_quarantine": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "cxx_header_dump": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "cxx_header_dump_original": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "cxx_header_dump_quarantine": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ue4ss_log": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ue4ss_log_original": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ue4ss_log_quarantine": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "capture": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "probe_intent": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "probe_receipt": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "probe_receipts": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "process_launch_receipt": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "process_result_receipt": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "process_receipts": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "capture_inventory": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "restore_receipts": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "inventory_checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "backup",
        "clone",
        "restored"
      ],
      "properties": {
        "original": {
          "$ref": "#/definitions/checksum"
        },
        "backup": {
          "$ref": "#/definitions/nullableChecksum"
        },
        "clone": {
          "$ref": "#/definitions/nullableChecksum"
        },
        "restored": {
          "$ref": "#/definitions/nullableChecksum"
        }
      }
    },
    "probe_receipt_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "process_launch_receipt_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "process_result_receipt_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "capture_inventory_checksum": {
      "$ref": "#/definitions/nullableChecksum"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "at_utc"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 10,
            "pattern": "^CGCE-OPS-[A-Z0-9-]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "at_utc": {
            "$ref": "#/definitions/strictUtc"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "BACKUP_VERIFIED",
              "ORIGINAL_DEACTIVATED",
              "CLONE_ACTIVE",
              "PROBE_STAGED",
              "RUNNING",
              "CAPTURED",
              "EXPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "backup": {
                "$ref": "#/definitions/checksum"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CLONE_ACTIVE",
              "PROBE_STAGED",
              "RUNNING",
              "CAPTURED",
              "EXPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "clone": {
                "$ref": "#/definitions/checksum"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "PROBE_STAGED",
              "RUNNING",
              "CAPTURED",
              "EXPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "probe_receipt_checksum": {
            "$ref": "#/definitions/checksum"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CAPTURED",
              "EXPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "process_launch_receipt_checksum": {
            "$ref": "#/definitions/checksum"
          },
          "process_result_receipt_checksum": {
            "$ref": "#/definitions/checksum"
          },
          "capture_inventory_checksum": {
            "$ref": "#/definitions/checksum"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "EXPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "restored": {
                "$ref": "#/definitions/checksum"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "RESTORING"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "inventory_checksums": {
                "properties": {
                  "restored": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "anyOf": [
              {
                "$ref": "#/definitions/recoverySourceCreatedEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceBackupEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceCloneEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceRunningEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceCapturedEvidence"
              }
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "RESTORED"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "inventory_checksums": {
                "properties": {
                  "restored": {
                    "$ref": "#/definitions/checksum"
                  }
                }
              }
            }
          },
          {
            "anyOf": [
              {
                "$ref": "#/definitions/recoverySourceCreatedEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceBackupEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceCloneEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceRunningEvidence"
              },
              {
                "$ref": "#/definitions/recoverySourceCapturedEvidence"
              }
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CREATED",
              "BACKUP_VERIFIED",
              "ORIGINAL_DEACTIVATED",
              "CLONE_ACTIVE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "probe_receipt_checksum": {
            "type": "null"
          },
          "process_launch_receipt_checksum": {
            "type": "null"
          },
          "process_result_receipt_checksum": {
            "type": "null"
          },
          "capture_inventory_checksum": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "PROBE_STAGED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "process_launch_receipt_checksum": {
            "type": "null"
          },
          "process_result_receipt_checksum": {
            "type": "null"
          },
          "capture_inventory_checksum": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "RUNNING"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "process_launch_receipt_checksum": {
            "type": "null"
          },
          "process_result_receipt_checksum": {
            "type": "null"
          },
          "capture_inventory_checksum": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CREATED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "backup": {
                "type": "null"
              },
              "clone": {
                "type": "null"
              },
              "restored": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "BACKUP_VERIFIED",
              "ORIGINAL_DEACTIVATED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "clone": {
                "type": "null"
              },
              "restored": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CLONE_ACTIVE",
              "PROBE_STAGED",
              "RUNNING",
              "CAPTURED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "inventory_checksums": {
            "properties": {
              "restored": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "EXPORTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "EXPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      }
    }
  ],
  "definitions": {
    "strictUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "anyOf": [
        {
          "$ref": "#/definitions/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableChecksum": {
      "anyOf": [
        {
          "$ref": "#/definitions/checksum"
        },
        {
          "type": "null"
        }
      ]
    },
    "checksum": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "recoverySourceCreatedEvidence": {
      "properties": {
        "inventory_checksums": {
